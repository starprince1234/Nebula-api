# Runtime
APP_ENV=development
HTTP_ADDRESS=:8080
DATABASE_URL=postgres://nebula:change_me@localhost:5432/nebula?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Control-plane sessions
JWT_SIGNING_KEY=replace_with_at_least_32_random_bytes
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=168

# Secret protection
API_KEY_HASH_PEPPER=replace_with_at_least_32_random_bytes
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=replace_with_32_random_bytes_base64

# First teacher bootstrap. These values are consumed only when no teacher exists.
BOOTSTRAP_TEACHER_NAME=Platform Teacher
BOOTSTRAP_TEACHER_EMAIL=teacher@example.com
BOOTSTRAP_TEACHER_PASSWORD=replace_with_a_strong_initial_password

# SMTP and email verification
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Nebula API
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=30
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
EMAIL_VERIFICATION_SEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_LOCKOUT_MINUTES=15
TEACHER_INVITATION_TTL_HOURS=24

# Redis Streams-backed authenticated SSE notifications
SSE_STREAM_MAX_LENGTH=1000
SSE_HEARTBEAT_SECONDS=15
