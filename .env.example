# Runtime
# Docker 本地启动固定由 Doppler nebula-api/dev_personal 注入；本文件只记录变量契约。
APP_ENV=development
HTTP_ADDRESS=:8080
PUBLIC_APP_URL=http://localhost:5173
DATABASE_URL=postgres://nebula:change_me@localhost:5432/nebula?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Control-plane sessions
JWT_SIGNING_KEY=replace_with_at_least_32_random_bytes_not_a_short_label
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=168
AUTH_STATE_HASH_PEPPER=replace_with_at_least_32_random_bytes_not_a_short_label

# Secret protection
API_KEY_HASH_PEPPER=replace_with_at_least_32_random_bytes_not_a_short_label
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=replace_with_32_random_bytes_base64

# First teacher bootstrap. These values are consumed only when no teacher exists.
BOOTSTRAP_TEACHER_NAME=Platform Teacher
BOOTSTRAP_TEACHER_EMAIL=teacher@example.com
BOOTSTRAP_TEACHER_PASSWORD=replace_with_a_strong_initial_password

# Optional fixed student and mentor test accounts. Configure each NAME/EMAIL/PASSWORD triplet together.
TEST_STUDENT_1_NAME=
TEST_STUDENT_1_EMAIL=
TEST_STUDENT_1_PASSWORD=
TEST_STUDENT_2_NAME=
TEST_STUDENT_2_EMAIL=
TEST_STUDENT_2_PASSWORD=
TEST_STUDENT_3_NAME=
TEST_STUDENT_3_EMAIL=
TEST_STUDENT_3_PASSWORD=
TEST_MENTOR_1_NAME=
TEST_MENTOR_1_EMAIL=
TEST_MENTOR_1_PASSWORD=
TEST_MENTOR_2_NAME=
TEST_MENTOR_2_EMAIL=
TEST_MENTOR_2_PASSWORD=
TEST_MENTOR_3_NAME=
TEST_MENTOR_3_EMAIL=
TEST_MENTOR_3_PASSWORD=

# SMTP and email verification
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Nebula API
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=30
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
EMAIL_VERIFICATION_SEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_LOCKOUT_MINUTES=15
TEACHER_INVITATION_TTL_HOURS=24

# Redis Streams-backed authenticated SSE notifications
SSE_STREAM_MAX_LENGTH=1000
SSE_HEARTBEAT_SECONDS=15

# Gateway transport limits. These are global transport settings, not provider fields.
UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
UPSTREAM_RESPONSE_HEADER_TIMEOUT_SECONDS=60
GATEWAY_MAX_REQUEST_BYTES=104857600
VIDEO_TASK_ROUTE_TTL_HOURS=24
